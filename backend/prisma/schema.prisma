generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id           String   @id
  externalId   String   @unique
  title        String
  searchTitle  String
  description  String?
  thumbnailUrl String?
  duration     Int
  category     String?
  author       String?
  sourceUrl    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSyncedAt DateTime
  favorites Favorite[]
  history WatchHistory[]
  progress PlaybackProgress[]

  @@index([title])
  @@index([searchTitle])
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions RefreshSession[]
  favorites Favorite[]
  history WatchHistory[]
  progress PlaybackProgress[]
}

model RefreshSession {
  id String @id
  userId String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Favorite {
  userId String
  videoId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@id([userId, videoId])
}

model WatchHistory {
  userId String
  videoId String
  lastWatchedAt DateTime @default(now())
  completed Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@id([userId, videoId])
  @@index([userId, lastWatchedAt])
}

model PlaybackProgress {
  userId String
  videoId String
  positionSeconds Float
  durationSeconds Float
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@id([userId, videoId])
  @@index([userId, updatedAt])
}
