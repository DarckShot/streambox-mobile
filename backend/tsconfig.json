{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "lib": ["ES2022"],
    "moduleResolution": "node", "outDir": "dist", "rootDir": ".",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "skipLibCheck": true, "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
